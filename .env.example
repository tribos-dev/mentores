# ID da planilha compartilhada com a conta de serviço
GOOGLE_SHEETS_SPREADSHEET_ID=
# Nome da aba (ela deve existir antes do primeiro envio)
GOOGLE_SHEETS_TAB=Horas
# E-mail e chave privada da conta de serviço do Google Cloud
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Webhook do espaço do Google Chat (somente no servidor)
GOOGLE_CHAT_WEBHOOK_URL=
# Link opcional exibido na notificação
PUBLIC_SHEET_URL=
